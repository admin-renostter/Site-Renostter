# ============================================================
# Renostter — Variáveis de ambiente para produção na VPS
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no Git.
# ============================================================

# ---------- Identificação da imagem ----------
IMAGE_TAG=latest
INSTALL_ML=false

# ---------- PostgreSQL ----------
POSTGRES_DB=renostter_careers
POSTGRES_USER=renostter_app
# Gere uma senha forte: openssl rand -base64 32
POSTGRES_PASSWORD=troque-por-senha-forte-aqui

# ---------- Django -> PostgreSQL ----------
# O settings.py le estas, nao as POSTGRES_* (aquelas so criam o banco no
# container). Sem elas o Django cai no SQLite default.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=renostter_careers
DB_USER=renostter_app
DB_PASSWORD=a-mesma-de-POSTGRES_PASSWORD
DB_CONN_MAX_AGE=60

# ---------- Django ----------
# Gere: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=gere-uma-chave-com-python-secrets-token-urlsafe-64
DEBUG=False
TIME_ZONE=America/Sao_Paulo

# 127.0.0.1 e obrigatorio: o HEALTHCHECK do Dockerfile faz
# curl http://127.0.0.1:8000/healthz/ de dentro do container, e sem esse
# host o Django responde 400 DisallowedHost - o container fica 'unhealthy'
# para sempre e o worker nunca libera a dependencia.
ALLOWED_HOSTS=carreiras.renostter.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://carreiras.renostter.com,http://localhost

# ---------- Segurança HTTP ----------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
DJANGO_ADMIN_URL=internal-django-admin-renostter/

# ---------- Paths internos (dentro do container) ----------
PRIVATE_MEDIA_ROOT=/app/private_media
LANCEDB_URI=/app/lancedb
SQLALCHEMY_AUDIT_URL=sqlite:////app/audit/audit.sqlite3

# ---------- Cache ----------
# Em prod, usar Redis. django-q2 também usa Redis.
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://redis:6379/1
Q_CLUSTER_WORKERS=2

# ---------- Gunicorn ----------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ---------- E-mail (Resend ou SMTP) ----------
# Opção A: Resend (recomendado, 3k emails/mês grátis)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL="Renostter RH <rh@renostter.com.br>"
RH_EMAIL=rh@renostter.com.br

# Opção B: SMTP (Outlook) - descomente se preferir
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=rh@renostter.com.br
# EMAIL_HOST_PASSWORD=sua-senha-de-app
# EMAIL_USE_TLS=True

# ---------- Supabase Storage (currículos) ----------
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_STORAGE_BUCKET=curriculos
SUPABASE_SIGNED_URL_TTL_SECONDS=3600
SUPABASE_STORAGE_LIMIT_BYTES=1073741824
STORAGE_CLEANUP_THRESHOLD_PERCENT=95

# ---------- Usuário master ----------
MASTER_USERNAME=adminrenostter@gmail.com
MASTER_EMAIL=adminrenostter@gmail.com
# Mude no primeiro login
MASTER_PASSWORD=senha-master-inicial-forte

# ---------- ML / Triagem (opcional) ----------
AGNO_ENABLED=False
# Se quiser triagem por IA local, suba com INSTALL_ML=true no build

# ---------- Cloudflare Tunnel ----------
# NAO existe variavel a preencher aqui. O tunnel roda em modo LOCAL:
# `deploy/scripts/cloudflared-setup.sh` cria o tunnel, grava as credenciais em
# deploy/cloudflared/renostter.json e escreve o UUID no config.yml.
# Definir CLOUDFLARE_TUNNEL_TOKEN faria o cloudflared entrar em modo
# "remotely-managed" e ignorar o ingress do config.yml (todas as rotas caem).

# ---------- Backblaze B2 (backup off-site) ----------
# Crie em: https://www.backblaze.com/b2 (10 GB grátis)
B2_APPLICATION_KEY_ID=seu-key-id
B2_APPLICATION_KEY=sua-application-key
B2_BUCKET_NAME=renostter-backups
B2_BUCKET_ID=seu-bucket-id

# ---------- Backup externo: Cloudflare R2 (usado pelo deploy/scripts/backup.sh) ----------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=renostter-backups

# ---------- Migracao do Render (temporario) ----------
# Render Dashboard > seu Postgres > Connections > External Database URL
# Use SO durante a migracao e apague a linha depois.
RENDER_EXTERNAL_DATABASE_URL=postgresql://usuario:senha@host.oregon-postgres.render.com/banco
